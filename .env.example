# Bu dosyayı .env.local olarak kopyalayın. Gerçek değerleri BU dosyaya yazmayın.

# Canlı alan adı (sonunda "/" olmadan). Boşsa canonical, sitemap ve sitemap bağlantısı üretilmez.
# Örnek: https://www.ornek-alan-adi.com
NEXT_PUBLIC_SITE_URL=

# --- İsteğe bağlı: Google yorumları (Places API New) ---
# Yalnızca sunucuda kullanılır; başına NEXT_PUBLIC_ EKLEMEYİN.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
